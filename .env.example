# StockBridge v3.1 — secrets only + required infrastructure credentials.
# Non-secret store info, supplier identifiers, contact address, discounts,
# public app URL and LIVE/DRY-RUN are editable from dashboard Settings.
# Do not commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/DATABASE?sslmode=require
ADMIN_USER=admin
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD_AT_LEAST_12_CHARS
CRON_SECRET=REPLACE_WITH_RANDOM_CRON_SECRET
# Vercel SHOPIFY_API_VERSION defaults to 2026-10. Optional override:
# SHOPIFY_API_VERSION=2026-10

# Each installed Shopify store needs an offline Admin API access token
# and Shopify app webhook HMAC secret. Store domain/name/supplier are in Neon.
STORE_A_ACCESS_TOKEN=REPLACE_WITH_STORE_A_OFFLINE_TOKEN
STORE_A_WEBHOOK_SECRET=REPLACE_WITH_STORE_A_SIGNING_SECRET
STORE_B_ACCESS_TOKEN=REPLACE_WITH_STORE_B_OFFLINE_TOKEN
STORE_B_WEBHOOK_SECRET=REPLACE_WITH_STORE_B_SIGNING_SECRET
# Enable additional stores only when installed and configured in dashboard:
# STORE_C_ACCESS_TOKEN=REPLACE_WITH_STORE_C_OFFLINE_TOKEN
# STORE_C_WEBHOOK_SECRET=REPLACE_WITH_STORE_C_SIGNING_SECRET
# STORE_D_ACCESS_TOKEN=REPLACE_WITH_STORE_D_OFFLINE_TOKEN
# STORE_D_WEBHOOK_SECRET=REPLACE_WITH_STORE_D_SIGNING_SECRET
